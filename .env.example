# ServiceOS environment template. Copy to .env (never commit real secrets).
# SERVICEOS_ prefixed variables take precedence over the unprefixed fallbacks.

# Required for the server (npm start) and migrations (npm run migrate).
# PostgreSQL is the authoritative ServiceOS persistence layer.
SERVICEOS_DATABASE_URL=postgresql://serviceos:serviceos@localhost:5432/serviceos

# Optional: listen port (default 8080; 0 = ephemeral)
#SERVICEOS_PORT=8080

# Optional: debug | info | warn | error (default info)
#SERVICEOS_LOG_LEVEL=info

# Optional: development | test | production (default development)
#SERVICEOS_NODE_ENV=development

# Test-harness only: enables gated live-database integration tests against a
# disposable PostgreSQL database. Never read by the runtime.
#SERVICEOS_TEST_DATABASE_URL=postgresql://serviceos:serviceos@localhost:5432/serviceos_test
